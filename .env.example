# コピーして .env を作る。.env は .gitignore 済み。
SMTP_HOST=smtp.example.jp
SMTP_PORT=587
SMTP_USERNAME=bear-watch@example.jp
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
ALERT_SENDER=bear-watch@example.jp
ALERT_SENDER_NAME=クマ監視システム
ALERT_RECIPIENTS=ryoyukai@example.jp,police@example.jp
CONFIRM_URL_BASE=https://bear.example.jp/e/
DATABASE_URL=sqlite:///./bearwatch.db
MEDIA_ROOT=./media

# 端末トークン（token:device_id のカンマ区切り）
DEVICE_TOKENS=probe-test-token:mediapad-t3-001
